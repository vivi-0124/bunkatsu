{
  "name": "hono",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "lint": "biome check --write",
    "format": "biome format --write",
    "typecheck": "vue-tsc --noEmit",
    "fix": "pnpm lint && pnpm format && pnpm typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/infra": "^0.2.14",
    "@better-fetch/fetch": "^1.1.21",
    "@hono/node-server": "^1.13.7",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.2.0",
    "@hono/zod-validator": "^0.7.6",
    "@libsql/client": "^0.15.15",
    "@mdi/font": "^7.4.47",
    "better-auth": "1.6.19",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.3",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.6",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^20",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.8",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "^6.0.7",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.2.0"
  }
}
